# Study Kingdom — every setting the project reads, by where it lives.
# Never commit real values. Secrets go into the platform's secret store.

# ---------------------------------------------------------------------------
# Worker API (Cloudflare). Non-secrets: apps/server/wrangler.jsonc "vars".
# Secrets: `npx wrangler secret put NAME` (from apps/server).
# Local development: copy apps/server/.dev.vars.example to apps/server/.dev.vars.
# ---------------------------------------------------------------------------
ENVIRONMENT=production                      # development | production
SITE_URL=https://study-kingdom.YOUR-SUBDOMAIN.workers.dev
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  # secret store (public-ish, but keep out of git)
DATABASE_URL=postgresql://game_api.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_PREPARE=true                             # "false" only with the transaction pooler (port 6543)
SUPABASE_JWT_SECRET=                        # only for projects still on legacy HS256 signing
VERIFIER=edge                               # edge | chunked | inline (inline = dev only)
VERIFY_FUNCTION_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/verify-battle
VERIFY_SHARED_SECRET=                       # `openssl rand -hex 32`; same value in the Edge Function
VERIFY_CHUNK_BUDGET=2500                    # work units per Worker invocation for chunked fallback

# ---------------------------------------------------------------------------
# Supabase Edge Function (supabase/functions/.env locally;
# `npx supabase secrets set VERIFY_SHARED_SECRET=...` in production)
# ---------------------------------------------------------------------------
# VERIFY_SHARED_SECRET=...

# ---------------------------------------------------------------------------
# Supabase Auth configuration script (scripts/supabase/configure-auth.mjs)
# ---------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=                      # personal access token — never commit
SUPABASE_PROJECT_REF=
# ---------------------------------------------------------------------------
# Mac release (scripts/release/*; GitHub Actions secrets for CI)
# ---------------------------------------------------------------------------
TAURI_SIGNING_PRIVATE_KEY=                  # CI only; locally read from ~/.tauri/study-kingdom.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=         # CI only; locally read from the Keychain
SK_API_URL=                                 # overrides release.config.json apiUrl
# Optional Apple Developer ID signing + notarization (paid membership):
APPLE_SIGNING_IDENTITY=
APPLE_CERTIFICATE=                          # CI: base64 of the .p12
APPLE_CERTIFICATE_PASSWORD=
APPLE_ID=
APPLE_PASSWORD=                             # app-specific password
APPLE_TEAM_ID=

# ---------------------------------------------------------------------------
# Client build (Vite)
# ---------------------------------------------------------------------------
VITE_API_URL=                               # desktop builds only; web uses same origin

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Encrypted database backups (scripts/db/backup.sh). Admin session-pooler URL;
# keep the key file outside the repository and store a separate recovery copy.
# BACKUP_KEY_FILE=/private/path/study-kingdom-backup.key
# RESTORE_DATABASE_URL=postgresql://ADMIN:SECRET@RECOVERY-HOST:5432/postgres
# Optional: PGTOOLS_CONTAINER=sk-test-pg for local PostgreSQL client tools.
